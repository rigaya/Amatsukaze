ARG GHCR_OWNER=rigaya
FROM ghcr.io/${GHCR_OWNER}/amatsukaze-builder:ubuntu2004

# AviSynth+ は Ubuntu 20.04 でビルドした単一資産 (_linux) を使う。
# 20.04 でビルドしたものは glibc 2.31 以降のディストリで動くため、OS別に分ける必要がない。
ARG ACF_VERSION=0.7.5
ARG DEBIAN_FRONTEND=noninteractive \
    OSVER=ubuntu2004
ARG AVISYNTHPLUS_DEB_NAME=https://github.com/rigaya/AviSynthCUDAFilters/releases/download/${ACF_VERSION}/avisynth_3.7.5-1_amd64_linux.deb

ENV LANG=ja_JP.UTF-8
ENV LC_ALL=ja_JP.UTF-8
ENV LC_CTYPE=ja_JP.UTF-8
USER root
RUN apt-get update \
    && wget -q ${AVISYNTHPLUS_DEB_NAME} -O avisynth.deb \
    && apt-get install -y ./avisynth.deb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm avisynth.deb

WORKDIR /work

ENV AMT_BASELIBS_DIR=/amt/baselibs
ENV AMT_PKGCONFIG_FFNK_DIR=/amt/ffmpeg_nekopanda/build/lib/pkgconfig
ENV AMT_PKGCONFIG_FF612_DIR=/amt/ffmpeg_612/build/lib/pkgconfig
