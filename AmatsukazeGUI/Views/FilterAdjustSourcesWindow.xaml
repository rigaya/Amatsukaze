<Window x:Class="Amatsukaze.Views.FilterAdjustSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="フィルタ調整の素材を選択" Width="860" Height="470" MinWidth="460" MinHeight="380"
        FontSize="{DynamicResource AMT.FontSize}"
        WindowStartupLocation="CenterOwner" Loaded="LoadSources">
    <!-- 他のウィンドウと同じく、基本設定のフォントサイズとテーマの配色に従う -->
    <Window.Resources>
        <ResourceDictionary Source="CommonResources.xaml"/>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <Label Content="プロファイル" Target="{Binding ElementName=Profiles}" Padding="0,0,0,4"/>
            <ComboBox x:Name="Profiles" DisplayMemberPath="Name" Margin="0,0,0,12"/>
            <TextBlock Text="既存の素材" FontWeight="Bold" Margin="0,0,0,4"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Button Content="選んだ素材を開く" HorizontalAlignment="Right" Padding="10,3" Click="OpenSource"/>
            <TextBlock Text="新しいTSから" FontWeight="Bold" Margin="0,12,0,4"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="参照" Margin="6,0,0,0" Padding="10,3" Click="Browse"/>
                <TextBox x:Name="InputPath" AllowDrop="True" PreviewDragOver="PreviewInputDragOver"
                         PreviewDrop="DropInput" VerticalContentAlignment="Center"
                         AutomationProperties.Name="入力TSファイルのパス"/>
            </DockPanel>
            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="AddButton" Content="TS解析してフィルタ調整" Padding="10,3" Click="AddSource"/>
                <Button Content="閉じる" IsCancel="True" Margin="6,0,0,0" Padding="10,3"/>
            </WrapPanel>
        </StackPanel>
        <ListView x:Name="Sources" SelectionMode="Single" MouseDoubleClick="OpenSource">
            <ListView.Resources>
                <!-- Fluentテーマの既定の文字サイズを使わず基本設定に従わせ、切れた名前はツールチップで全体を見せる -->
                <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="FontSize" Value="{DynamicResource AMT.FontSize}"/>
                    <Style.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                        </Style>
                    </Style.Resources>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="入力ファイル名" DisplayMemberBinding="{Binding FileName}" Width="520"/>
                    <GridViewColumn Header="モード" DisplayMemberBinding="{Binding ModeText}" Width="90"/>
                    <GridViewColumn Header="作成時のプロファイル" DisplayMemberBinding="{Binding ProfileName}" Width="180"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
