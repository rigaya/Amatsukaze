@using System.Text.Json.Nodes
@using Amatsukaze.Shared

<tbody>
    @if (IsEncoderFilter())
            {
                <tr>
                    <th>固定フィルタ設定</th>
                    <td>
                        <fieldset class="profile-filter-panel">
                            <legend class="profile-filter-legend">
                                <label>
                                    <input type="checkbox" checked="@GetEncoderFilterBool("EnableDeinterlace")" @onchange="@(e => ApplyChangeAsync(() => OnEncoderFilterBoolChanged(e, "EnableDeinterlace")))" title="@EncoderFilterHelp.Deinterlace" />
                                    <span title="@EncoderFilterHelp.Deinterlace">インターレース解除</span>
                                </label>
                            </legend>
                            <div style="margin-top: 6px;">
                                <select @onchange="@(e => ApplyChangeAsync(() => OnEncoderFilterEnumChanged(e, "DeinterlaceAlgorithm", _encoderDeinterlaceEnumNames)))" disabled="@(!GetEncoderFilterBool("EnableDeinterlace"))" title="@GetEncoderDeinterlaceAlgorithmHelp()">
                                    @foreach (var item in GetArrayOptions(_encoderDeinterlaceLabels, GetEncoderFilterEnumIndex("DeinterlaceAlgorithm", _encoderDeinterlaceEnumNames)))
                                    {
                                        <option value="@item.Value" selected="@item.Selected">@item.Label</option>
                                    }
                                </select>
                                @if (HasEncoderDeinterlaceParam())
                                {
                                    <select style="margin-left: 6px;" @onchange="@(e => ApplyChangeAsync(() => OnEncoderDeinterlaceParamChanged(e)))" disabled="@(!GetEncoderFilterBool("EnableDeinterlace"))" title="@GetEncoderDeinterlaceParamHelp()">
                                        @foreach (var item in GetEncoderDeinterlaceParamOptions())
                                        {
                                            <option value="@item.Value" selected="@item.Selected">@item.Label</option>
                                        }
                                    </select>
                                }
                                @if (IsEncoderKfm())
                                {
                                    <label style="margin-left: 8px;" title="@EncoderFilterHelp.KfmUcf">
                                        <input type="checkbox" checked="@GetEncoderFilterBool("KfmEnableUcf")" @onchange="@(e => ApplyChangeAsync(() => OnEncoderFilterBoolChanged(e, "KfmEnableUcf")))" disabled="@(!GetEncoderFilterBool("EnableDeinterlace"))" />
                                        ucf
                                    </label>
                                }
                            </div>
                        </fieldset>
                        <fieldset class="profile-filter-panel">
                            <legend class="profile-filter-legend">
                                <label>
                                    <input type="checkbox" checked="@GetEncoderFilterBool("EnableDenoise")" @onchange="@(e => ApplyChangeAsync(() => OnEncoderFilterBoolChanged(e, "EnableDenoise")))" title="@EncoderFilterHelp.Denoise" />
                                    <span title="@EncoderFilterHelp.Denoise">ノイズ除去</span>
                                </label>
                            </legend>
                            <div style="margin-top: 6px;">
                                <select @onchange="@(e => ApplyChangeAsync(() => OnEncoderFilterEnumChanged(e, "DenoiseAlgorithm", _encoderDenoiseEnumNames)))" disabled="@(!GetEncoderFilterBool("EnableDenoise"))" title="@GetEncoderDenoiseAlgorithmHelp()">
                                    @foreach (var item in GetArrayOptions(_encoderDenoiseLabels, GetEncoderFilterEnumIndex("DenoiseAlgorithm", _encoderDenoiseEnumNames)))
                                    {
                                        <option value="@item.Value" selected="@item.Selected">@item.Label</option>
                                    }
                                </select>
                                @if (IsEncoderDenoiseValueVisible())
                                {
                                    <span style="margin-left: 8px;" title="@GetEncoderDenoiseValueHelp()">@GetEncoderDenoiseValueLabel()</span>
                                    <input type="number" step="any" style="width: 90px; margin-left: 4px;" value="@GetEncoderDenoiseValue()"
                                           title="@GetEncoderDenoiseValueHelp()" @oninput="@(e => ApplyChangeAsync(() => OnEncoderDenoiseValueChanged(e)))"
                                           disabled="@(!GetEncoderFilterBool("EnableDenoise"))" />
                                }
                            </div>
                        </fieldset>
                        <fieldset class="profile-filter-panel">
                            <legend class="profile-filter-legend">
                                <label>
                                    <input type="checkbox" checked="@GetEncoderFilterBool("EnableResize")" @onchange="@(e => ApplyChangeAsync(() => OnEncoderFilterBoolChanged(e, "EnableResize")))" title="@EncoderFilterHelp.Resize" />
                                    <span title="@EncoderFilterHelp.Resize">リサイズ</span>
                                </label>
                            </legend>
                            <div style="margin-top: 6px;" title="@EncoderFilterHelp.Resize">
                                <span>横</span>
                                <input type="number" style="width: 80px; margin-left: 4px;" value="@GetEncoderFilterInt("ResizeWidth")"
                                       @oninput="@(e => ApplyChangeAsync(() => OnEncoderFilterIntChanged(e, "ResizeWidth")))" disabled="@(!GetEncoderFilterBool("EnableResize"))" />
                                <span style="margin-left: 6px;">x 高さ</span>
                                <input type="number" style="width: 80px; margin-left: 4px;" value="@GetEncoderFilterInt("ResizeHeight")"
                                       @oninput="@(e => ApplyChangeAsync(() => OnEncoderFilterIntChanged(e, "ResizeHeight")))" disabled="@(!GetEncoderFilterBool("EnableResize"))" />
                            </div>
                        </fieldset>
                        <fieldset class="profile-filter-panel">
                            <legend class="profile-filter-legend">
                                <label>
                                    <input type="checkbox" checked="@GetEncoderFilterBool("EnableEdgeEnhance")" @onchange="@(e => ApplyChangeAsync(() => OnEncoderFilterBoolChanged(e, "EnableEdgeEnhance")))" title="@EncoderFilterHelp.EdgeEnhance" />
                                    <span title="@EncoderFilterHelp.EdgeEnhance">エッジ強調</span>
                                </label>
                            </legend>
                            <div style="margin-top: 6px;">
                                <select @onchange="@(e => ApplyChangeAsync(() => OnEncoderFilterEnumChanged(e, "EdgeAlgorithm", _encoderEdgeEnumNames)))" disabled="@(!GetEncoderFilterBool("EnableEdgeEnhance"))" title="@GetEncoderEdgeAlgorithmHelp()">
                                    @foreach (var item in GetArrayOptions(_encoderEdgeLabels, GetEncoderFilterEnumIndex("EdgeAlgorithm", _encoderEdgeEnumNames)))
                                    {
                                        <option value="@item.Value" selected="@item.Selected">@item.Label</option>
                                    }
                                </select>
                                <span style="margin-left: 8px;" title="@GetEncoderEdgeAlgorithmHelp()">@GetEncoderEdgeValueLabel()</span>
                                <input type="number" step="any" style="width: 90px; margin-left: 4px;" value="@GetEncoderEdgeValue()"
                                       title="@GetEncoderEdgeAlgorithmHelp()" @oninput="@(e => ApplyChangeAsync(() => OnEncoderEdgeValueChanged(e)))"
                                       disabled="@(!GetEncoderFilterBool("EnableEdgeEnhance"))" />
                            </div>
                        </fieldset>
                        <label style="margin: 4px 8px;" title="@EncoderFilterHelp.Deband">
                            <input type="checkbox" checked="@GetEncoderFilterBool("EnableDeband")" @onchange="@(e => ApplyChangeAsync(() => OnEncoderFilterBoolChanged(e, "EnableDeband")))" />
                            バンディング低減
                        </label>
                        <div style="margin: 4px 8px;" title="@GetEncoderOutputDepthHelp()">
                            <label>
                                <input type="checkbox" checked="@GetEncoderFilterBool("EnableOutputDepth")" @onchange="@(e => ApplyChangeAsync(() => OnEncoderFilterBoolChanged(e, "EnableOutputDepth")))" />
                                出力ビット深度
                            </label>
                            <select style="margin-left: 8px;" @onchange="@(e => ApplyChangeAsync(() => OnEncoderFilterEnumChanged(e, "OutputDepth", _encoderOutputDepthEnumNames)))" disabled="@(!GetEncoderFilterBool("EnableOutputDepth"))">
                                @foreach (var item in GetArrayOptions(_encoderOutputDepthLabels, GetEncoderFilterEnumIndex("OutputDepth", _encoderOutputDepthEnumNames)))
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Label</option>
                                }
                            </select>
                            <div class="text-muted small" style="white-space: pre-line;">@GetEncoderOutputDepthHelp()</div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <th>フィルタオプション</th>
                    <td>
                        <textarea style="width: 100%; height: 80px;" title="@EncoderFilterHelp.FilterOption" @oninput="@(e => ApplyChangeAsync(() => OnEncoderFilterOptionChanged(e)))">@GetEncoderFilterOption()</textarea>
                        <div class="text-muted small" style="white-space: pre-line;">@EncoderFilterHelp.FilterOption</div>
                    </td>
                </tr>
            }
            else if (IsSettingFilter())
            {
                <tr>
                    <th></th>
                    <td>
                        <div style="margin-bottom: 8px;">
                            <label>
                                <input type="checkbox" checked="@GetFilterBool("EnableCUDA")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "EnableCUDA")))" />
                                CUDAで処理
                            </label>
                        </div>
                        <fieldset class="profile-filter-panel">
                            <legend class="profile-filter-legend">
                                <label>
                                    <input type="checkbox" checked="@GetFilterBool("EnableDeinterlace")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "EnableDeinterlace")))" />
                                    インターレース解除
                                </label>
                            </legend>
                            <div style="margin-top: 6px;">
                                <span>解除方法</span>
                                <select style="margin-left: 6px;" @onchange="@(e => ApplyChangeAsync(() => OnDeinterlaceChanged(e)))" disabled="@(!GetFilterBool("EnableDeinterlace"))">
                                    @foreach (var item in GetIndexOptions(_options?.DeinterlaceAlgorithmList, GetDeinterlaceIndex()))
                                    {
                                        <option value="@item.Value" selected="@item.Selected">@item.Label</option>
                                    }
                                </select>
                            </div>
                            @if (GetFilterBool("EnableDeinterlace"))
                            {
                                @if (IsDeinterlace("KFM"))
                                {
                                    <div style="margin-top: 8px;">
                                        <label>
                                            <input type="checkbox" checked="@GetFilterBool("KfmEnableNr")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "KfmEnableNr")))" />
                                            SMDegrainによるノイズリダクション
                                        </label>
                                        <br />
                                        <label>
                                            <input type="checkbox" checked="@GetFilterBool("KfmEnableUcf")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "KfmEnableUcf")))" />
                                            DecombUCF
                                        </label>
                                        <div style="margin-top: 6px;">
                                            <span>出力fps</span>
                                            <select style="margin-left: 6px;" @onchange="@(e => ApplyChangeAsync(() => OnKfmFpsChanged(e)))">
                                                @foreach (var item in GetKfmFpsOptions())
                                                {
                                                    <option value="@item.Value" selected="@item.Selected">@item.Label</option>
                                                }
                                            </select>
                                        </div>
                                        <div style="margin-top: 6px;">
                                            <span>VFRフレームタイミング</span>
                                            <select style="margin-left: 6px;" @onchange="@(e => ApplyChangeAsync(() => OnKfmVfrTimingChanged(e)))">
                                                @foreach (var item in GetIndexOptions(_options?.VfrFpsList, GetKfmVfrIndex()))
                                                {
                                                    <option value="@item.Value" selected="@item.Selected">@item.Label</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                }
                                else if (IsDeinterlace("D3DVP"))
                                {
                                    <div style="margin-top: 8px;">
                                        <span>使用GPU</span>
                                        <select style="margin-left: 6px;" @onchange="@(e => ApplyChangeAsync(() => OnD3dvpGpuChanged(e)))">
                                            @foreach (var item in GetIndexOptions(_options?.D3dvpGpuList, GetD3dvpGpuIndex()))
                                            {
                                                <option value="@item.Value" selected="@item.Selected">@item.Label</option>
                                            }
                                        </select>
                                    </div>
                                }
                                else if (IsDeinterlace("QTGMC"))
                                {
                                    <div style="margin-top: 8px;">
                                        <span>プリセット</span>
                                        <select style="margin-left: 6px;" @onchange="@(e => ApplyChangeAsync(() => OnQtgmcPresetChanged(e)))">
                                            @foreach (var item in GetIndexOptions(_options?.QtgmcPresetList, GetQtgmcPresetIndex()))
                                            {
                                                <option value="@item.Value" selected="@item.Selected">@item.Label</option>
                                            }
                                        </select>
                                    </div>
                                }
                                else if (IsDeinterlace("Yadif"))
                                {
                                    <div style="margin-top: 8px;">
                                        <span>出力fps</span>
                                        <select style="margin-left: 6px;" @onchange="@(e => ApplyChangeAsync(() => OnYadifFpsChanged(e)))">
                                            @foreach (var item in GetYadifFpsOptions())
                                            {
                                                <option value="@item.Value" selected="@item.Selected">@item.Label</option>
                                            }
                                        </select>
                                    </div>
                                }
                                else if (IsDeinterlace("AutoVfr"))
                                {
                                    <div style="margin-top: 8px;">
                                        <div>
                                            <span>並列数</span>
                                            <input type="number" min="1" max="16" style="width: 70px; margin-left: 6px;" value="@GetFilterInt("AutoVfrParallel")" @oninput="@(e => ApplyChangeAsync(() => OnFilterIntChanged(e, "AutoVfrParallel")))" />
                                        </div>
                                        <label>
                                            <input type="checkbox" checked="@GetFilterBool("AutoVfrFast")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "AutoVfrFast")))" />
                                            Fastを使う
                                        </label>
                                        <br />
                                        <label>
                                            <input type="checkbox" checked="@GetFilterBool("AutoVfr30F")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "AutoVfr30F")))" />
                                            30fpsを使う
                                        </label>
                                        <br />
                                        <label>
                                            <input type="checkbox" checked="@GetFilterBool("AutoVfr60F")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "AutoVfr60F")))" />
                                            60fpsを使う
                                        </label>
                                        <br />
                                        <label>
                                            <input type="checkbox" checked="@GetFilterBool("AutoVfr24A")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "AutoVfr24A")))" />
                                            24fps部分にAutoVfr.iniで設定した関数を使う
                                        </label>
                                        <br />
                                        <label>
                                            <input type="checkbox" checked="@GetFilterBool("AutoVfr30A")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "AutoVfr30A")))" />
                                            30fps部分にAutoVfr.iniで設定した関数を使う
                                        </label>
                                        <br />
                                        <label>
                                            <input type="checkbox" checked="@GetFilterBool("AutoVfrCrop")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "AutoVfrCrop")))" />
                                            IsCrop
                                        </label>
                                        <div style="margin-top: 6px;">
                                            <span>SKIP</span>
                                            <input type="number" min="0" max="3" style="width: 60px; margin-left: 6px;" value="@GetFilterInt("AutoVfrSkip")" @oninput="@(e => ApplyChangeAsync(() => OnFilterIntChanged(e, "AutoVfrSkip")))" />
                                        </div>
                                        <div style="margin-top: 6px;">
                                            <span>REF</span>
                                            <input type="number" style="width: 60px; margin-left: 6px;" value="@GetFilterInt("AutoVfrRef")" @oninput="@(e => ApplyChangeAsync(() => OnFilterIntChanged(e, "AutoVfrRef")))" />
                                        </div>
                                    </div>
                                }
                            }
                        </fieldset>
                        <fieldset class="profile-filter-panel">
                            <legend class="profile-filter-legend">
                                <label>
                                    <input type="checkbox" checked="@GetFilterBool("EnableDeblock")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "EnableDeblock")))" />
                                    デブロッキング
                                </label>
                            </legend>
                            <div style="margin-top: 6px;">
                                <span>強度</span>
                                <select style="margin-left: 6px;" @onchange="@(e => ApplyChangeAsync(() => OnDeblockStrengthChanged(e)))" disabled="@(!GetFilterBool("EnableDeblock"))">
                                    @foreach (var item in GetIndexOptions(_options?.DeblockStrengthList, GetDeblockStrengthIndex()))
                                    {
                                        <option value="@item.Value" selected="@item.Selected">@item.Label</option>
                                    }
                                </select>
                                <span style="margin-left: 12px;">品質</span>
                                <select style="margin-left: 6px;" @onchange="@(e => ApplyChangeAsync(() => OnDeblockQualityChanged(e)))" disabled="@(!GetFilterBool("EnableDeblock"))">
                                    @foreach (var item in GetIndexOptions(_options?.DeblockQualityList, GetDeblockQualityIndex()))
                                    {
                                        <option value="@item.Value" selected="@item.Selected">@item.Label</option>
                                    }
                                </select>
                                <label style="margin-left: 12px;">
                                    <input type="checkbox" checked="@GetFilterBool("DeblockSharpen")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "DeblockSharpen")))" disabled="@(!GetFilterBool("EnableDeblock"))" />
                                    シャープ化
                                </label>
                            </div>
                        </fieldset>
                        <fieldset class="profile-filter-panel">
                            <legend class="profile-filter-legend">
                                <label>
                                    <input type="checkbox" checked="@GetFilterBool("EnableResize")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "EnableResize")))" />
                                    リサイズ
                                </label>
                            </legend>
                            <div style="margin-top: 6px;">
                                <span>横</span>
                                <input type="number" min="1" style="width: 70px; margin-left: 4px;" value="@GetFilterInt("ResizeWidth")" @oninput="@(e => ApplyChangeAsync(() => OnFilterIntChanged(e, "ResizeWidth")))" disabled="@(!GetFilterBool("EnableResize"))" />
                                <span style="margin-left: 6px;">x 縦</span>
                                <input type="number" min="1" style="width: 70px; margin-left: 4px;" value="@GetFilterInt("ResizeHeight")" @oninput="@(e => ApplyChangeAsync(() => OnFilterIntChanged(e, "ResizeHeight")))" disabled="@(!GetFilterBool("EnableResize"))" />
                                <button class="btn btn-sm btn-secondary" style="margin-left: 8px;" @onclick="async () => { SetResizePreset(1280, 720); await NotifyChanged(); }" disabled="@(!GetFilterBool("EnableResize"))">1280x720</button>
                                <button class="btn btn-sm btn-secondary" style="margin-left: 4px;" @onclick="async () => { SetResizePreset(1920, 1080); await NotifyChanged(); }" disabled="@(!GetFilterBool("EnableResize"))">1920x1080</button>
                            </div>
                        </fieldset>
                        <label>
                            <input type="checkbox" checked="@GetFilterBool("EnableTemporalNR")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "EnableTemporalNR")))" />
                            時間軸安定化
                        </label>
                        <br />
                        <label>
                            <input type="checkbox" checked="@GetFilterBool("EnableDeband")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "EnableDeband")))" />
                            バンディング低減
                        </label>
                        <br />
                        <label>
                            <input type="checkbox" checked="@GetFilterBool("EnableEdgeLevel")" @onchange="@(e => ApplyChangeAsync(() => OnFilterBoolChanged(e, "EnableEdgeLevel")))" />
                            エッジ強調（アニメ用）
                        </label>
                    </td>
                </tr>
            }
</tbody>

@code {
    [Parameter, EditorRequired] public JsonObject Profile { get; set; } = new();
    [Parameter] public ProfileOptions? Options { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private ProfileOptions? _options => Options;

    private Task NotifyChanged() => Changed.InvokeAsync();

    private async Task ApplyChangeAsync(Action change)
    {
        change();
        await NotifyChanged();
    }
    private JsonNode? GetNode(string name) => GetNodeFromObject(Profile, name);
    private JsonObject? GetObjectNode(string name) => GetNode(name) as JsonObject;
    private string GetStringValue(string name) => TryGetStringFromNode(GetNode(name), out var value) ? value : "";
    private void OnStringChanged(ChangeEventArgs e, string name) => SetNodeValue(name, JsonValue.Create(e.Value?.ToString() ?? ""));
    private void SetNodeValue(string name, JsonNode? value)
    {
        var key = GetMatchingKey(Profile, name);
        if (!ReferenceEquals(Profile[key], value)) Profile[key] = value;
    }

    private static readonly string[] _encoderEnumNames = new[] { "x264", "x265", "QSVEnc", "NVEnc", "VCEEnc", "SVTAV1", "x262" };
    private static readonly string[] _filterEnumNames = new[] { "None", "Setting", "Custom", "QSVEncFilter", "NVEncFilter", "VCEEncFilter" };
    private static readonly string[] _deblockStrengthEnumNames = new[] { "Strong", "Medium", "Weak", "Weaker" };
    private static readonly string[] _d3dvpGpuEnumNames = new[] { "Auto", "Intel", "NVIDIA", "Radeon" };
    private static readonly string[] _qtgmcPresetEnumNames = new[] { "Auto", "Faster", "Fast", "Medium", "Slow", "Slower" };
    private static readonly string[] _encoderDeinterlaceEnumNames = new[] { "Afs", "KFM", "NNEDI", "Yadif", "Bwdif", "Decomb", "IVTC" };
    private static readonly string[] _encoderDeinterlaceLabels = new[] { "afs", "kfm", "nnedi", "yadif", "bwdif", "decomb", "ivtc" };
    private static readonly string[] _encoderAfsPresetEnumNames = new[] { "Default", "Triple", "Double", "Anime", "Cinema", "MinAfterimg", "Fps24", "Fps30" };
    private static readonly string[] _encoderAfsPresetLabels = new[] { "default", "triple", "double", "anime", "cinema", "min_afterimg", "24fps", "30fps" };
    private static readonly string[] _encoderKfmModeEnumNames = new[] { "VFR", "Fps60", "Fps24" };
    private static readonly string[] _encoderKfmModeLabels = new[] { "vfr", "60", "24" };
    private static readonly string[] _encoderDeintModeEnumNames = new[] { "Normal", "Bob" };
    private static readonly string[] _encoderDeintModeLabels = new[] { "normal", "bob" };
    private static readonly string[] _encoderDenoiseEnumNames = new[] { "PMD", "KNN", "NLMeans", "HQDN3D", "DenoiseDct", "Smooth", "FFT3D", "Convolution3D", "MSmooth" };
    private static readonly string[] _encoderDenoiseLabels = new[] { "pmd", "knn", "nlmeans", "hqdn3d", "denoise-dct", "smooth", "fft3d", "convolution3d", "msmooth" };
    private static readonly string[] _encoderEdgeEnumNames = new[] { "EdgeLevel", "Unsharp", "WarpSharp", "MSharpen" };
    private static readonly string[] _encoderEdgeLabels = new[] { "edgelevel", "unsharp", "warpsharp", "msharpen" };
    private static readonly string[] _encoderOutputDepthEnumNames = new[] { "Bit8", "Bit10" };
    private static readonly string[] _encoderOutputDepthLabels = new[] { "8bit", "10bit" };

    private void OnDeinterlaceChanged(ChangeEventArgs e)
    {
        var idx = ParseIndex(e.Value);
        var list = _options?.DeinterlaceAlgorithmList ?? new List<string>();
        if (idx < 0 || idx >= list.Count)
        {
            idx = 0;
        }
        var name = list.Count > 0 ? list[idx] : "KFM";
        SetFilterValue("DeinterlaceAlgorithm", JsonValue.Create(name));
    }

    private void OnDeblockStrengthChanged(ChangeEventArgs e)
    {
        var idx = ParseIndex(e.Value);
        if (idx < 0 || idx >= _deblockStrengthEnumNames.Length)
        {
            idx = 0;
        }
        SetFilterValue("DeblockStrength", JsonValue.Create(_deblockStrengthEnumNames[idx]));
    }

    private void OnDeblockQualityChanged(ChangeEventArgs e)
    {
        var idx = ParseIndex(e.Value);
        var values = _options?.DeblockQualityValues ?? new List<int>();
        if (idx < 0 || idx >= values.Count)
        {
            idx = 0;
        }
        var value = values.Count > 0 ? values[idx] : 4;
        SetFilterValue("DeblockQuality", JsonValue.Create(value));
    }

    private void OnKfmFpsChanged(ChangeEventArgs e)
    {
        var enumNames = _options?.FilterFpsEnumNamesKfm ?? new List<string>();
        if (enumNames.Count == 0)
        {
            return;
        }
        var idx = ParseIndex(e.Value);
        if (idx < 0 || idx >= enumNames.Count)
        {
            idx = 0;
        }
        SetFilterValue("KfmFps", JsonValue.Create(enumNames[idx]));
    }

    private void OnKfmVfrTimingChanged(ChangeEventArgs e)
    {
        var idx = ParseIndex(e.Value);
        SetFilterValue("KfmVfr120fps", JsonValue.Create(idx == 1));
    }

    private void OnD3dvpGpuChanged(ChangeEventArgs e)
    {
        var idx = ParseIndex(e.Value);
        if (idx < 0 || idx >= _d3dvpGpuEnumNames.Length)
        {
            idx = 0;
        }
        SetFilterValue("D3dvpGpu", JsonValue.Create(_d3dvpGpuEnumNames[idx]));
    }

    private void OnQtgmcPresetChanged(ChangeEventArgs e)
    {
        var idx = ParseIndex(e.Value);
        if (idx < 0 || idx >= _qtgmcPresetEnumNames.Length)
        {
            idx = 0;
        }
        SetFilterValue("QtgmcPreset", JsonValue.Create(_qtgmcPresetEnumNames[idx]));
    }

    private void OnYadifFpsChanged(ChangeEventArgs e)
    {
        var enumNames = _options?.FilterFpsEnumNamesYadif ?? new List<string>();
        if (enumNames.Count == 0)
        {
            return;
        }
        var idx = ParseIndex(e.Value);
        if (idx < 0 || idx >= enumNames.Count)
        {
            idx = 0;
        }
        SetFilterValue("YadifFps", JsonValue.Create(enumNames[idx]));
    }

    private int GetEncoderIndex()
    {
        var node = GetNode("EncoderType");
        if (TryGetIntFromNode(node, out var idx))
        {
            return idx;
        }
        var str = TryGetStringFromNode(node, out var stringValue) ? stringValue : "";
        if (!string.IsNullOrEmpty(str))
        {
            var index = Array.FindIndex(_encoderEnumNames, v => string.Equals(v, str, StringComparison.OrdinalIgnoreCase));
            return index >= 0 ? index : 0;
        }
        return 0;
    }

    private string GetEncoderOutputDepthHelp()
    {
        return EncoderFilterHelp.OutputDepth(IsSvtAv1Encoder());
    }

    private string GetEncoderDeinterlaceAlgorithmHelp()
    {
        return EncoderFilterHelp.DeinterlaceAlgorithm(
            GetEncoderFilterEnumString("DeinterlaceAlgorithm", _encoderDeinterlaceEnumNames));
    }

    private string GetEncoderDeinterlaceParamHelp()
    {
        return EncoderFilterHelp.DeinterlaceParam(
