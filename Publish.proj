<Project DefaultTargets="PublishAll" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    publish.bat のビルド本体。
    ネイティブと .NET publish を同時に走らせる。
    ネイティブは、Release と Release2 でオプションが同じライブラリを1回だけ作り、
    Amatsukaze.dll / Amatsukaze2.dll のコンパイルと LTCG リンクを並列にする。
    LTCG は切らない。PCH は使わない。SelfContained は維持する。
  -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <PublishIntermediate>$(RepoRoot)publish\intermediate\win-x64\</PublishIntermediate>
    <WebUiPublishDir>$(PublishIntermediate)AmatsukazeWebUI\</WebUiPublishDir>
    <!-- PublishDir はアプリごとに変える。参照プロジェクトの再コンパイルは全アプリで同じ出力へ向くため、先に1回だけ行う。 -->
    <DotNetAppBuildProps>RuntimeIdentifier=win-x64;Configuration=Release;SelfContained=true;PublishSingleFile=true</DotNetAppBuildProps>
    <!-- Blazor WASM はトリミング付き publish が既定。SelfContained=false を渡すと NETSDK1102 になる。 -->
    <DotNetWebBuildProps>Configuration=Release</DotNetWebBuildProps>
    <!-- 2本の LTCG を同じプロセス内で走らせ、cl.exe の総数だけはコア数に抑える -->
    <_NativeToolProps>Platform=x64;SolutionDir=$(RepoRoot);UseMultiToolTask=true;EnforceProcessCountAcrossBuilds=true</_NativeToolProps>
    <NativeReleaseProps>Configuration=Release;$(_NativeToolProps)</NativeReleaseProps>
    <NativeReleaseNoRefProps>$(NativeReleaseProps);BuildProjectReferences=false;BuildPassReferences=false</NativeReleaseNoRefProps>
    <NativeRelease2NoRefProps>Configuration=Release2;$(_NativeToolProps);BuildProjectReferences=false;BuildPassReferences=false</NativeRelease2NoRefProps>
  </PropertyGroup>

  <ItemGroup>
    <DotNetApp Include="$(RepoRoot)AmatsukazeAddTask\AmatsukazeAddTask.csproj">
      <AdditionalProperties>RuntimeIdentifier=win-x64;Configuration=Release;SelfContained=true;PublishSingleFile=true;BuildProjectReferences=false;PublishDir=$(PublishIntermediate)AmatsukazeAddTask\</AdditionalProperties>
    </DotNetApp>
    <DotNetApp Include="$(RepoRoot)AmatsukazeServerCLI\AmatsukazeServerCLI.csproj">
      <AdditionalProperties>RuntimeIdentifier=win-x64;Configuration=Release;SelfContained=true;PublishSingleFile=true;BuildProjectReferences=false;PublishDir=$(PublishIntermediate)AmatsukazeServerCLI\</AdditionalProperties>
    </DotNetApp>
    <DotNetApp Include="$(RepoRoot)AmatsukazeGUI\AmatsukazeGUI.csproj">
      <AdditionalProperties>RuntimeIdentifier=win-x64;Configuration=Release;SelfContained=true;PublishSingleFile=true;BuildProjectReferences=false;PublishDir=$(PublishIntermediate)AmatsukazeGUI\</AdditionalProperties>
    </DotNetApp>
    <DotNetApp Include="$(RepoRoot)ScriptCommand\ScriptCommand.csproj">
      <AdditionalProperties>RuntimeIdentifier=win-x64;Configuration=Release;SelfContained=true;PublishSingleFile=true;BuildProjectReferences=false;PublishDir=$(PublishIntermediate)ScriptCommand\</AdditionalProperties>
    </DotNetApp>
    <DotNetWebUi Include="$(RepoRoot)AmatsukazeWebUI\AmatsukazeWebUI.csproj">
      <AdditionalProperties>Configuration=Release;BuildProjectReferences=false;PublishDir=$(WebUiPublishDir)</AdditionalProperties>
    </DotNetWebUi>
  </ItemGroup>

  <Target Name="PublishAll">
    <ItemGroup>
      <TopStage Include="$(MSBuildThisFileFullPath)">
        <AdditionalProperties>PublishStage=native</AdditionalProperties>
      </TopStage>
      <TopStage Include="$(MSBuildThisFileFullPath)">
        <AdditionalProperties>PublishStage=dotnet</AdditionalProperties>
      </TopStage>
    </ItemGroup>
    <!-- 同じプロジェクトでも AdditionalProperties が違えば別ビルドとして並列になる -->
    <MSBuild Projects="@(TopStage)" Targets="RunStage" BuildInParallel="true" />
  </Target>

  <Target Name="RunStage">
    <CallTarget Targets="BuildNative" Condition="'$(PublishStage)'=='native'" />
    <CallTarget Targets="PublishDotNet" Condition="'$(PublishStage)'=='dotnet'" />
    <CallTarget Targets="DepCommon" Condition="'$(PublishStage)'=='dep-common'" />
    <CallTarget Targets="DepLibfaad" Condition="'$(PublishStage)'=='dep-libfaad'" />
    <CallTarget Targets="DepCaption" Condition="'$(PublishStage)'=='dep-caption'" />
    <CallTarget Targets="CompileAmatsukazeRelease" Condition="'$(PublishStage)'=='compile-release'" />
    <CallTarget Targets="CompileAmatsukazeRelease2" Condition="'$(PublishStage)'=='compile-release2'" />
    <CallTarget Targets="LinkReleasePipe" Condition="'$(PublishStage)'=='link-release'" />
    <CallTarget Targets="LinkRelease2" Condition="'$(PublishStage)'=='link-release2'" />
    <CallTarget Targets="DepWrapper" Condition="'$(PublishStage)'=='dep-wrapper'" />
    <Error Text="Unknown PublishStage: $(PublishStage)"
           Condition="'$(PublishStage)' != '' and '$(PublishStage)' != 'native' and '$(PublishStage)' != 'dotnet' and '$(PublishStage)' != 'dep-common' and '$(PublishStage)' != 'dep-libfaad' and '$(PublishStage)' != 'dep-caption' and '$(PublishStage)' != 'compile-release' and '$(PublishStage)' != 'compile-release2' and '$(PublishStage)' != 'link-release' and '$(PublishStage)' != 'link-release2' and '$(PublishStage)' != 'dep-wrapper'" />
  </Target>

  <Target Name="BuildNative">
    <Message Importance="high" Text="native: dependencies + Amatsukaze compile $([System.DateTime]::Now.ToString('HH:mm:ss'))" />
    <ItemGroup>
      <CompileStage Include="$(MSBuildThisFileFullPath)">
        <AdditionalProperties>PublishStage=dep-common</AdditionalProperties>
      </CompileStage>
      <CompileStage Include="$(MSBuildThisFileFullPath)">
        <AdditionalProperties>PublishStage=dep-libfaad</AdditionalProperties>
      </CompileStage>
      <CompileStage Include="$(MSBuildThisFileFullPath)">
        <AdditionalProperties>PublishStage=dep-caption</AdditionalProperties>
      </CompileStage>
      <CompileStage Include="$(MSBuildThisFileFullPath)">
        <AdditionalProperties>PublishStage=compile-release</AdditionalProperties>
      </CompileStage>
      <CompileStage Include="$(MSBuildThisFileFullPath)">
        <AdditionalProperties>PublishStage=compile-release2</AdditionalProperties>
      </CompileStage>
    </ItemGroup>
    <MSBuild Projects="@(CompileStage)" Targets="RunStage" BuildInParallel="true" />

    <Message Importance="high" Text="native: LTCG link $([System.DateTime]::Now.ToString('HH:mm:ss'))" />
    <ItemGroup>
      <LinkStage Include="$(MSBuildThisFileFullPath)">
        <AdditionalProperties>PublishStage=link-release</AdditionalProperties>
      </LinkStage>
      <LinkStage Include="$(MSBuildThisFileFullPath)">
        <AdditionalProperties>PublishStage=link-release2</AdditionalProperties>
      </LinkStage>
      <LinkStage Include="$(MSBuildThisFileFullPath)">
        <AdditionalProperties>PublishStage=dep-wrapper</AdditionalProperties>
      </LinkStage>
    </ItemGroup>
    <MSBuild Projects="@(LinkStage)" Targets="RunStage" BuildInParallel="true" />
    <Message Importance="high" Text="native: done $([System.DateTime]::Now.ToString('HH:mm:ss'))" />
  </Target>

  <Target Name="DepCommon">
    <MSBuild Projects="$(RepoRoot)common\common.vcxproj" Targets="Build" Properties="$(NativeReleaseProps)" />
  </Target>

  <Target Name="DepLibfaad">
    <MSBuild Projects="$(RepoRoot)libfaad\libfaad2.vcxproj" Targets="Build" Properties="$(NativeReleaseProps)" />
  </Target>

  <Target Name="DepCaption">
    <MSBuild Projects="$(RepoRoot)TVCaptionMod2\Caption_src\Caption.vcxproj" Targets="Build" Properties="$(NativeReleaseProps)" />
  </Target>

  <Target Name="DepWrapper">
    <MSBuild Projects="$(RepoRoot)ScriptCommandWrapper\ScriptCommandWrapper.vcxproj" Targets="Build" Properties="$(NativeReleaseProps)" />
  </Target>

  <!-- 参照ライブラリは作らず、コンパイルだけ先に進める。リンクはライブラリ完成後。 -->
  <Target Name="CompileAmatsukazeRelease">
    <MSBuild Projects="$(RepoRoot)Amatsukaze\Amatsukaze.vcxproj"
             Targets="BuildGenerateSources;BuildCompile"
             Properties="$(NativeReleaseNoRefProps)" />
  </Target>

  <Target Name="CompileAmatsukazeRelease2">
    <MSBuild Projects="$(RepoRoot)Amatsukaze\Amatsukaze.vcxproj"
             Targets="BuildGenerateSources;BuildCompile"
             Properties="$(NativeRelease2NoRefProps)" />
  </Target>

  <Target Name="LinkReleasePipe">
    <MSBuild Projects="$(RepoRoot)Amatsukaze\Amatsukaze.vcxproj"
             Targets="BuildLink;FinalizeBuildStatus"
             Properties="$(NativeReleaseNoRefProps)" />
    <!-- Amatsukaze.dll のインポートライブラリが揃ってから exe をリンクする。Release2 の LTCG とは並列。 -->
    <!-- 参照の再ビルドで Amatsukaze.dll の LTCG をやり直さない。出力は直前の BuildLink で揃っている。 -->
    <MSBuild Projects="$(RepoRoot)AmatsukazeCLI\AmatsukazeCLI.vcxproj;$(RepoRoot)AmatsukazeGenLogo\AmatsukazeGenLogo.vcxproj"
             Targets="Build"
             Properties="$(NativeReleaseNoRefProps)"
             BuildInParallel="true" />
  </Target>

  <Target Name="LinkRelease2">
    <MSBuild Projects="$(RepoRoot)Amatsukaze\Amatsukaze.vcxproj"
             Targets="BuildLink;FinalizeBuildStatus"
             Properties="$(NativeRelease2NoRefProps)" />
  </Target>

  <!--
    .NET の restore。PublishDotNet が別の MSBuild のプロセスで呼ぶ。
    同じビルドの中で restore すると、restore で増えた import(NuGet から入る Microsoft.NET.Sdk.WebAssembly.Pack など)が
    あとのビルドに反映されない。obj が無いと、WebUI の publish が MSB4057 (ResolveWasmOutputs) で失敗する。
  -->
  <Target Name="RestoreDotNet">
    <Message Importance="high" Text="dotnet: restore $([System.DateTime]::Now.ToString('HH:mm:ss'))" />
    <!-- アプリ同士は同じプロパティで restore し、WebUI とは段を分ける。project.assets.json の同時書き込みを避ける。 -->
    <MSBuild Projects="@(DotNetApp)" Targets="Restore" BuildInParallel="true" Properties="$(DotNetAppBuildProps)" />
    <MSBuild Projects="@(DotNetWebUi)" Targets="Restore" Properties="$(DotNetWebBuildProps)" />
  </Target>

  <Target Name="PublishDotNet">
    <!-- ネイティブと並列のまま、restore だけ別のプロセスにする(/restore だとネイティブの開始が restore の分遅れる)。 -->
    <Exec Command="&quot;$(MSBuildBinPath)\MSBuild.exe&quot; &quot;$(MSBuildThisFileFullPath)&quot; /t:RestoreDotNet /m /nr:false /nologo /v:m" />
    <Message Importance="high" Text="dotnet: build shared references $([System.DateTime]::Now.ToString('HH:mm:ss'))" />
    <!-- GUI が ServerWin / Server / Shared を引き連れる。WebUI も Shared を同じ obj へ出すので、同時にはビルドしない。 -->
    <MSBuild Projects="$(RepoRoot)AmatsukazeGUI\AmatsukazeGUI.csproj" Targets="Build" Properties="$(DotNetAppBuildProps)" />
    <MSBuild Projects="$(RepoRoot)AmatsukazeWebUI\AmatsukazeWebUI.csproj" Targets="Build" Properties="$(DotNetWebBuildProps)" />
    <!-- ハッシュ付きファイルが publish 先に残り続けないよう、WebUI の出力だけ毎回消す。obj は残す。 -->
    <RemoveDir Directories="$(WebUiPublishDir)" />
    <Message Importance="high" Text="dotnet: publish $([System.DateTime]::Now.ToString('HH:mm:ss'))" />
    <MSBuild Projects="@(DotNetApp);@(DotNetWebUi)" Targets="Publish" BuildInParallel="true" />
    <Error Text="WebUI wwwroot was not produced: $(WebUiPublishDir)wwwroot" Condition="!Exists('$(WebUiPublishDir)wwwroot')" />
    <Message Importance="high" Text="dotnet: done $([System.DateTime]::Now.ToString('HH:mm:ss'))" />
  </Target>
</Project>
